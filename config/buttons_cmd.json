  "commands": {
    "quick_battery_status": "shell dumpsys battery",
    "quick_device_info": "shell getprop",
    "quick_display_info": "shell wm size",
    "quick_storage_info": "shell df -h",
    "quick_cpu_info": "shell cat /proc/cpuinfo",
    "quick_memory_info": "shell cat /proc/meminfo",
    "quick_top_processes": "shell top -n 1",
    "quick_ip_info": "shell ip addr show wlan0",
    "quick_wifi_info": "shell dumpsys wifi",
    "quick_clear_logcat": "logcat -c",
    "quick_airplane_mode": "shell settings put global airplane_mode_on",
    "take_screenshot": "shell screencap -p /sdcard/screenshot.png",
    "quick_screen_record": "shell screenrecord /sdcard/screen.mp4",
    "reboot_device": "reboot",
    "reboot_recovery": "reboot recovery",
    "reboot_bootloader": "reboot bootloader",
    "reboot_loader": "reboot loader",
    "factory_menu": "shell am startservice -n com.xbh.factory.menu/.app.TvMenuWindowManagerService -e com.xbh.factory.menu.commmand com.xbh.factory.menu.commmand.factory_menu",
    "adb_root": "root",
    "adb_remount": "remount",
    "quick_enable_dev_options": "shell settings put global development_settings_enabled 1",
    "quick_disable_dev_options": "shell settings put global development_settings_enabled 0",
    "quick_get_screen_timeout": "shell settings get system screen_off_timeout",
    "quick_set_screen_timeout": "shell settings put system screen_off_timeout",
    "quick_open_settings": "shell am start -a android.settings.SETTINGS"
  },
