        {
          "id": "push_file",
          "label": "⬆️ Push File to Device",
          "action": "push_file",
          "accent": false,
          "params": [
            {
              "name": "source",
              "type": "file",
              "label": "源文件",
              "required": true
            },
            {
              "name": "dest",
              "type": "text",
              "label": "目标路径",
              "required": true,
              "default": "/sdcard/"
            }
          ]
        },
        {
          "id": "pull_file",
